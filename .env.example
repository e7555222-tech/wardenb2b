# ── Frontend (Streamlit) ──────────────────────────────────────────────────────
API_URL=http://localhost:8000
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./warden.db
# Üretimde uzun, rastgele bir değer kullanın: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
WEBHOOK_SECRET=change-me-for-n8n-callback-auth
OPENAI_API_KEY=
# JWT erişim token süresi (dakika)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Admin Seed (auto-creates admin user on first startup) ────────────────────
# Aşağıdaki değerler YEREL DEMO içindir. Üretimde mutlaka güçlü, gizli bir
# parola ile değiştirin (en az 8 karakter, harf + rakam).
ADMIN_EMAIL=admin@warden.demo
ADMIN_PASSWORD=WardenAdmin2024!
ADMIN_NAME=Warden Admin

# ── Demo Data Seed (true = create demo user + sample leads on first startup) ─
DEMO_SEED=false

# ── Docker Compose (PostgreSQL) ───────────────────────────────────────────────
POSTGRES_PASSWORD=warden123

# ── CORS (comma-separated origins, * allows all) ─────────────────────────────
CORS_ORIGINS=*
